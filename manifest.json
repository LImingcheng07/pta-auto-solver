{
  "manifest_version": 3,
  "name": "PTA Auto Solver",
  "version": "3.0.0",
  "description": "枫璇科技出品 — 自动完成 PTA 编程题目（读题 → AI 生成 → 写入 → 自测 → 调试 → 提交 → 下一题）",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "*://pintia.cn/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://pintia.cn/*"],
    "js": ["content.js"]
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PTA Auto Solver v3.0"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
